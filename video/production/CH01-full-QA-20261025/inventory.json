    "group": "chapterDialogue",
    "id": "C1FIX09",
    "src": "/video/current/C1FIX09-20261025.mp4",
    "title": "向甲问禁令与责任",
    "rows": [
      "D01",
      "D02",
      "D03",
      "D04",
      "D05",
      "D06"
    ],
    "lines": [
      {
        "id": "D01",
        "speaker": "我",
        "text": "今夜守帐怎么这么严？"
      },
      {
        "id": "D02",
        "speaker": "甲",
        "text": "丞相有口谕，今夜谁也不得入帐求见。"
      },
      {
        "id": "D03",
        "speaker": "我",
        "text": "可要是拦住不报，误了军情呢？"
      },
      {
        "id": "D04",
        "speaker": "甲",
        "text": "那也要问罪。"
      },
      {
        "id": "D05",
        "speaker": "甲",
        "text": "急报得赶紧送到，禁令也不能擅改。"
      },
      {
        "id": "D06",
        "speaker": "甲",
        "text": "我只能守门递话，不能处置军情。"
      }
    ],
