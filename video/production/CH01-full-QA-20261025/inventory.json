      "D10",
      "D11",
      "D12",
      "D13"
    ],
    "lines": [
      {
        "id": "D08",
        "speaker": "乙",
        "text": "姜伯约，姜维将军。"
      },
      {
        "id": "D09",
        "speaker": "乙",
        "text": "入夜前，丞相吩咐过，今夜军务由他接报处置。"
      },
      {
        "id": "D10",
        "speaker": "我",
        "text": "他在哪里？"
      },
      {
        "id": "D11",
        "speaker": "乙",
        "text": "在丞相的中军帐里。"
      },
      {
        "id": "D12",
        "speaker": "乙",
        "text": "他自己的将军帐就在那边，帐前有亲兵。"
      },
      {
        "id": "D13",
        "speaker": "乙",
        "text": "他认得传令规矩，能到中军帐外递话。"
      }
    ],
