      "E04",
      "E04C"
    ],
    "lines": [
      {
        "id": "E03",
        "speaker": "姜维",
        "text": "魏将军，营前情势如何？"
      },
      {
        "id": "E04",
        "speaker": "演出",
        "text": "魏延向姜维报明营前军情。"
      },
      {
        "id": "E04C",
        "speaker": "演出",
        "text": "姜维听完军报，问清细节。"
