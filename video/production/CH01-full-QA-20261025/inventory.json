  {
    "index": 20,
    "group": "chapterDialogue",
    "id": "C1T19-17",
    "src": "/video/current/C1T19-17-cut-3385b7d0-20261023.mp4",
    "title": "复述与回令",
    "rows": [
      "E09",
      "E10",
      "E11"
    ],
    "lines": [
      {
        "id": "E09",
        "speaker": "我",
        "text": "守营门，再探敌情，未明虚实不出营追击；有新军情，立即报姜将军。"
      },
      {
        "id": "E10",
        "speaker": "魏延",
        "text": "听见了，我这就去。"
      },
      {
        "id": "E11",
        "speaker": "我（心声）",
        "text": "这回，我等到了。"
      }
    ],
    "metadata": {
      "duration": 17.375,
      "width": 1280,
      "height": 720,
