    "group": "chapterDialogue",
    "id": "C1T14-request-20261024",
    "src": "/video/current/C1T14-request-20261024-67408788.mp4",
    "title": "随亲兵同行并请姜维接报",
    "rows": [
      "J08",
      "J08A",
      "J08E"
    ],
    "lines": [
      {
        "id": "J08",
        "speaker": "我",
        "text": "请将军在帐外接报。"
      },
      {
        "id": "J08A",
        "speaker": "我",
        "text": "敌军尚未攻营，但今夜有变，不能耽误。"
      },
      {
        "id": "J08E",
        "speaker": "演出",
        "text": "帐内传来低咳，姜维回头一望，又看向营前。"
      }
    ],
