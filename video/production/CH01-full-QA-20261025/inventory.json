  {
    "index": 21,
    "group": "chapterDialogue",
    "id": "C1T13-investigation-20261024",
    "src": "/video/current/C1T13-investigation-20261024-f9bd1b3b.mp4",
    "title": "试探迹象与上一轮记忆",
    "rows": [
      "D21",
      "D22",
      "D23",
      "D24",
      "D26"
    ],
    "lines": [
      {
        "id": "D21",
        "speaker": "我",
        "text": "他们是在往营里冲，还是在等咱们动？"
      },
      {
        "id": "D22",
        "speaker": "斥候",
        "text": "奇怪的是，咱们不动，他们也不往前。"
      },
      {
        "id": "D23",
        "speaker": "斥候",
        "text": "哪边一调兵，他们那边就换个方向。"
      },
      {
        "id": "D24",
        "speaker": "斥候",
        "text": "敌骑还在营外，没碰鹿角，也没见步卒跟进。"
      },
      {
        "id": "D26",
        "speaker": "我（心声）",
        "text": "上一回，魏延说敌军还在问：丞相为何不出、如今谁在发令。"
      }
    ],
    "metadata": {
      "duration": 28.0,
      "width": 1280,
