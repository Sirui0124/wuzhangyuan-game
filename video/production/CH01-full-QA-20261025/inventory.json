  {
    "index": 29,
    "group": "chapterDialogue",
    "id": "C1FIX15",
    "src": "/video/current/C1FIX15-20261025.mp4",
    "title": "姜维接报担责与亲兵同行",
    "rows": [
      "J09",
      "J09A",
      "J10",
      "J10A",
      "J10B",
      "J11",
      "J13"
    ],
    "lines": [
      {
        "id": "J09",
        "speaker": "姜维",
        "text": "禁令不能犯，军情也不能误。"
      },
      {
        "id": "J09A",
        "speaker": "姜维",
        "text": "今夜军务由我处置。"
      },
      {
        "id": "J10",
        "speaker": "姜维",
        "text": "请魏将军到帐外报明军情，是否禀报丞相，由我判断。"
      },
      {
        "id": "J10A",
        "speaker": "姜维",
        "text": "该我作的决定，我担责。"
      },
      {
        "id": "J10B",
        "speaker": "我",
        "text": "将军现在便去？"
      },
      {
        "id": "J11",
        "speaker": "姜维",
        "text": "我就在这里等他。你把话传到。"
      },
      {
        "id": "J13",
        "speaker": "亲兵",
        "text": "我随你同去。"
      }
    ],
