[
  {
    "id": "CH2-V02",
    "src": "/video/current/CH2-V02-player-holds-20261025.mp4",
    "title": "回忆与伤帐认人",
    "subtitles": "/video/subtitles/CH2-V02-player-holds-20261025.vtt",
    "duration": 54.875,
    "sha256": "8b60b195fcda69fefbb87452f618e7eee0228db5f2dbf54ba465cc365f680872",
    "bytes": 28678304,
    "cues": [
      {
        "start": 0.44,
        "end": 4.1,
        "text": "第四次北伐。这回，我成了运粮兵。"
      },
      {
        "start": 6.0,
        "end": 7.52,
        "text": "现在，到哪一步了？"
      },
      {
        "start": 8.28,
        "end": 9.92,
        "text": "这批粮，才送到？"
      },
      {
        "start": 11.86,
        "end": 15.42,
        "text": "迟了十日。督粮的苟安，已被丞相杖责八十。"
      },
      {
        "start": 16.88,
        "end": 19.02,
        "text": "苟安……他在哪儿？"
      },
      {
        "start": 19.94,
        "end": 20.84,
        "text": "那边帐里养伤。"
      },
      {
        "start": 22.56,
        "end": 26.66,
        "text": "我记得，苟安是李严的部下。他因运粮受罚，"
      },
      {
        "start": 26.66,
        "end": 27.68,
        "text": "怀恨在心。"
      },
      {
        "start": 28.18,
        "end": 31.68,
        "text": "后来他投了魏，又回来散布丞相篡位的谣言，"
      },
      {
        "start": 31.68,
        "end": 33.64,
        "text": "后主便召回了丞相。"
      },
      {
        "start": 34.72,
        "end": 38.26,
        "text": "得先弄清苟安现在的打算，也许还来得及。"
      },
      {
        "start": 39.28,
        "end": 41.04,
        "text": "原来你就是苟安？"
      },
      {
        "start": 45.68,
        "end": 47.06,
        "text": "你接下来打算降魏？"
      },
      {
        "start": 48.18,
        "end": 48.98,
        "text": "你说什么？"
      },
      {
        "start": 53.44,
        "end": 54.78,
        "text": "谁让你来问这个的？"
      }
    ],
    "provenance": {
      "original": "C:\\Users\\zhousirui\\Documents\\ChatGPT\\逆转五丈原\\video\\current\\CH2-V02-f485488faf-20261025.mp4",
