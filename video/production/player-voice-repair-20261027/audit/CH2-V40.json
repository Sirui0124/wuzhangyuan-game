  "cues": [
    {
      "start": 1.26,
      "end": 4.6,
      "text": "往下推的人是我，要问就问我"
    },
    {
      "start": 4.6,
      "end": 8.32,
      "text": "李严知情的事也写在材料里，该查就得查"
    },
    {
      "start": 9.92,
      "end": 12.7,
      "text": "李严革职，交回官印"
    },
    {
      "start": 12.7,
      "end": 16.54,
      "text": "苟安参与阻挠运粮、欺瞒军情，已按军法处死"
    },
    {
      "start": 17.04,
      "end": 17.88,
      "text": "李严倒了"
    },
    {
      "start": 18.8,
      "end": 20.36,
      "text": "苟安也死了"
    },
    {
      "start": 21.68,
      "end": 22.48,
      "text": "可粮呢？"
    }
  ],
