    {
      "start": 0.62,
      "end": 2.68,
      "text": "姜伯约，姜维将军"
    },
    {
      "start": 3.2,
      "end": 6.88,
      "text": "入夜前，丞相吩咐过，今夜军务由他接报处置"
    },
    {
      "start": 8.04,
      "end": 9.06,
      "text": "他在哪里？"
    },
    {
      "start": 9.46,
      "end": 10.76,
      "text": "在丞相的中军帐里"
    },
    {
      "start": 12.38,
      "end": 15.2,
      "text": "他自己的将军帐就在那边，帐前有亲兵"
    },
    {
      "start": 16.72,
      "end": 19.7,
      "text": "他认得传令规矩，能到中军帐外递话"
    }
