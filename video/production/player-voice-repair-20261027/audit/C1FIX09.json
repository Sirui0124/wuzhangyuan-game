  "cues": [
    {
      "start": 0.11,
      "end": 1.67,
      "text": "今夜守帐怎么这么严？"
    },
    {
      "start": 3.07,
      "end": 5.85,
      "text": "丞相有口谕，今夜谁也不得入帐求见"
    },
    {
      "start": 6.25,
      "end": 9.25,
      "text": "可要是拦住不报，误了军情呢？"
    },
    {
      "start": 9.25,
      "end": 10.61,
      "text": "那也要问罪"
    },
    {
      "start": 11.15,
      "end": 14.09,
      "text": "急报得赶紧送到，禁令也不能擅改"
    },
    {
      "start": 14.77,
      "end": 17.29,
      "text": "我只能守门递话，不能处置军情"
    }
  ],
