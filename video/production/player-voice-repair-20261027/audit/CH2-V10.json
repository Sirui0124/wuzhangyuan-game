  "duration": 45.76,
  "cues": [
    {
      "start": 0.0,
      "end": 1.64,
      "text": "你们先前议的是什么？"
    },
    {
      "start": 2.82,
      "end": 6.22,
      "text": "迟粮的事，究竟要不要往上说"
    },
    {
      "start": 8.34,
      "end": 10.98,
      "text": "我不想一直背着“饮酒误军”这几个字"
    },
    {
      "start": 16.24,
      "end": 20.94,
      "text": "我想把事情揭开，让这回北伐先停下来"
    },
    {
      "start": 21.48,
      "end": 24.18,
      "text": "你想讨回公道，为什么一定要停北伐？"
    },
    {
      "start": 25.0,
      "end": 28.4,
      "text": "这回把粮送到了，下一回呢？"
    },
    {
      "start": 28.4,
      "end": 32.2,
      "text": "难道换个人挨打，粮就自己长出来了？"
    },
    {
      "start": 33.16,
      "end": 34.72,
      "text": "如果还是没人肯查呢？"
    },
    {
      "start": 35.52,
      "end": 37.58,
      "text": "那我就换个肯听的地方"
    },
    {
      "start": 38.88,
      "end": 40.22,
      "text": "你就信得过魏国？"
    },
    {
      "start": 41.24,
      "end": 45.32,
      "text": "我也没底。你想让我留下，就给我指条路"
    }
  ],
