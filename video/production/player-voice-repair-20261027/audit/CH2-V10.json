  "title": "第一封信后的交谈",
  "subtitles": "/video/subtitles/CH2-V10-4d6adcdc1b-20261025.vtt",
  "file": "C:\\Users\\zhousirui\\Documents\\ChatGPT\\逆转五丈原\\video\\current\\CH2-V10-4d6adcdc1b-20261025.mp4",
