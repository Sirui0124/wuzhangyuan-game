    {
      "start": 0.11,
      "end": 4.41,
      "text": "请将两人的补充说明、原信和查粮材料一同登记收件"
    },
    {
      "start": 6.03,
      "end": 10.03,
      "text": "原信、查粮材料和两人的补充说明都已收齐"
    },
    {
      "start": 10.79,
      "end": 13.59,
      "text": "停手和各自的责任，会一并核实"
    },
    {
      "start": 13.59,
      "end": 18.81,
      "text": "李严交出此次粮运调度职责，受处分，仍须配合查问"
    },
    {
      "start": 18.81,
      "end": 24.01,
      "text": "苟安免去队长职务，承担饮酒、隐瞒和误导的责任"
    },
    {
      "start": 24.01,
      "end": 25.83,
      "text": "留下做普通粮兵"
    },
    {
      "start": 26.29,
      "end": 30.53,
      "text": "这次处置，已考虑两人停手补救的情节"
    },
    {
      "start": 31.25,
      "end": 33.37,
      "text": "该担的责任仍要担"
    }
  ],
