  "duration": 44.45875,
  "cues": [
    {
      "start": 0.44,
      "end": 4.1,
      "text": "第四次北伐。这回，我成了运粮兵"
    },
    {
      "start": 4.833,
      "end": 6.353,
      "text": "现在，到哪一步了？"
    },
    {
      "start": 7.113,
      "end": 8.753,
      "text": "这批粮，才送到？"
    },
    {
      "start": 10.693,
      "end": 14.253,
      "text": "迟了十日。督粮的苟安，已被丞相杖责八十"
    },
    {
      "start": 15.713,
      "end": 17.853,
      "text": "苟安……他在哪儿？"
    },
    {
      "start": 18.773,
      "end": 19.673,
      "text": "那边帐里养伤"
    },
    {
      "start": 20.31,
      "end": 24.41,
      "text": "我记得，苟安是李严的部下。他因运粮受罚"
    },
    {
      "start": 24.41,
      "end": 25.43,
      "text": "怀恨在心"
    },
    {
      "start": 25.93,
      "end": 29.43,
      "text": "后来他投了魏，又回来散布丞相篡位的谣言"
    },
    {
      "start": 29.43,
      "end": 31.39,
      "text": "后主便召回了丞相"
    },
    {
      "start": 32.47,
      "end": 36.01,
      "text": "得先弄清苟安现在的打算，也许还来得及"
    },
    {
      "start": 37.03,
      "end": 38.79,
      "text": "原来你就是苟安？"
    },
    {
      "start": 39.263,
      "end": 40.643,
      "text": "你接下来打算降魏？"
    },
    {
      "start": 41.763,
      "end": 42.563,
      "text": "你说什么？"
    },
    {
      "start": 42.94,
      "end": 44.28,
      "text": "谁让你来问这个的？"
    }
  ],
