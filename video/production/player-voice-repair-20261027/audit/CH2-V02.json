  "title": "回忆与伤帐认人",
  "subtitles": "/video/subtitles/CH2-V02-tight-bedside-20261027.vtt",
  "file": "C:\\Users\\zhousirui\\Documents\\ChatGPT\\逆转五丈原\\video\\current\\CH2-V02-tight-bedside-20261027.mp4",
