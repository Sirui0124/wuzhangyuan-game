  "cues": [
    {
      "start": 2.48,
      "end": 4.86,
      "text": "军情紧急，我须入帐通报"
    },
    {
      "start": 5.62,
      "end": 9.29,
      "text": "将军留步，帐前有禁令，今夜非要事不得入"
    },
    {
      "start": 10.94,
      "end": 12.26,
      "text": "我就是要事"
    },
    {
      "start": 13.02,
      "end": 14.54,
      "text": "魏军都到营前了"
    },
    {
      "start": 15.0,
      "end": 18.12,
      "text": "他们还在阵前叫嚷：“诸葛亮怎么不出来了？”"
    },
    {
      "start": 19.3,
      "end": 23.04,
      "text": "还在问：“蜀军如今是谁发令？”"
    },
    {
      "start": 25.25,
      "end": 29.53,
      "text": "你既要拦我，便说清如何不误通报"
    }
  ],
