  "cues": [
    {
      "start": 0.44000000000000006,
      "end": 4.525000000000001,
      "text": "第四次北伐。这回，我成了运粮兵"
    },
    {
      "start": 4.833,
      "end": 6.353,
      "text": "现在，到哪一步了？"
    },
    {
      "start": 7.113,
      "end": 8.753,
      "text": "这批粮，才送到？"
    },
    {
      "start": 10.693,
      "end": 14.253,
      "text": "迟了十日。督粮的苟安，已被丞相杖责八十"
    },
    {
      "start": 15.713,
      "end": 17.853,
      "text": "苟安……他在哪儿？"
    },
    {
      "start": 18.773,
      "end": 19.673,
      "text": "那边帐里养伤"
    },
    {
      "start": 20.70275,
      "end": 24.89275,
      "text": "我记得，苟安是李严的部下。他因运粮受罚"
    },
    {
      "start": 25.06275,
      "end": 25.81275,
      "text": "怀恨在心"
    },
    {
      "start": 26.25375,
      "end": 30.16375,
      "text": "后来他投了魏，又回来散布丞相篡位的谣言"
    },
    {
      "start": 30.493750000000002,
      "end": 31.723750000000003,
      "text": "后主便召回了丞相"
    },
    {
      "start": 32.509750000000004,
      "end": 36.29975,
      "text": "得先弄清苟安现在的打算，也许还来得及"
    },
    {
      "start": 37.38975,
      "end": 38.81975,
      "text": "原来你就是苟安？"
    },
    {
      "start": 39.250750000000004,
      "end": 40.99575,
      "text": "你接下来打算降魏？"
    },
    {
      "start": 41.763,
      "end": 42.563,
      "text": "你说什么？"
    },
    {
      "start": 42.94,
      "end": 44.28,
      "text": "谁让你来问这个的？"
    }
  ],
