  "rows": [
    {
      "id": "A-08",
      "speaker": "我（心声）",
      "text": "五丈原……第六夜。",
      "clue": ""
    },
    {
      "id": "A-16",
      "speaker": "我（心声）",
      "text": "魏延还没来。先看看帐前的告示。",
      "clue": ""
    },
    {
      "id": "A-17",
      "speaker": "告示",
      "text": "今夜帐内有要事，闲人不得擅入。",
      "clue": "C06"
    },
    {
      "id": "A-19",
      "speaker": "斥候",
      "text": "魏兵正在向营前逼近，魏将军马上就到，要入帐禀报。",
      "clue": ""
    },
    {
      "id": "A-23",
      "speaker": "我（选项）",
      "text": "营门失守了？",
      "clue": ""
    },
    {
      "id": "A-24",
      "speaker": "斥候",
      "text": "敌骑还在营外，没碰鹿角，也没见步卒跟进。前哨守得住。",
      "clue": "T02"
    },
    {
      "id": "A-23B",
      "speaker": "我（选项）",
      "text": "不行，今晚谁都不能进",
      "clue": ""
    },
    {
      "id": "A-24B",
      "speaker": "斥候",
      "text": "那便请你向魏将军说清楚。",
      "clue": ""
    },
    {
      "id": "A-28",
      "speaker": "魏延",
      "text": "军情紧急，我须入帐通报。",
      "clue": ""
    },
    {
      "id": "A-29",
      "speaker": "我",
      "text": "将军留步，帐前有禁令，今夜非要事不得入",
      "clue": ""
    },
    {
      "id": "A-30",
      "speaker": "魏延",
      "text": "我就是要事。",
      "clue": ""
    },
    {
      "id": "A-33",
      "speaker": "魏延",
      "text": "魏军都到营前了，他们还在阵前叫嚷：“诸葛亮怎么不出来了？”",
      "clue": ""
    },
    {
      "id": "A-34",
      "speaker": "魏延",
      "text": "还在问：“蜀军如今是谁发令？”",
      "clue": "C05"
    },
    {
      "id": "A-37",
      "speaker": "魏延",
      "text": "你既要拦我，便说清如何不误通报。",
      "clue": ""
    }
  ],
