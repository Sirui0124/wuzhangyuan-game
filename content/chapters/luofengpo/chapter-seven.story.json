      "portrait": "pangtong"
    },
    {
      "id": "PT-LOSS-CHOICE",
      "kind": "choice",
      "act": 2,
      "scene": "luocheng_tent",
      "speaker": "我",
      "portrait": "pangtong",
      "text": "我怎样回应？",
      "options": [
