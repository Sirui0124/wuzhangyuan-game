      "portrait": "pangtong"
    },
    {
      "id": "PT-RETREAT-4",
      "kind": "line",
      "act": 2,
      "scene": "luocheng_tent",
      "speaker": "我",
      "text": "我也不能替他答应。但这个回答，你活着才听得到。",
